# BugLens Core — Environment Variables
# Copy this file to .env and fill in your values

# ── Gemini AI ──────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── GitHub App ─────────────────────────────────────────────────────────────
# Create a GitHub App at: https://github.com/settings/apps/new
# Required permissions: Pull requests (Read & Write), Issues (Read & Write)
# Required events: Pull request, Installation
GITHUB_APP_ID=
# Paste the full private key including -----BEGIN/END RSA PRIVATE KEY----- lines
GITHUB_PRIVATE_KEY=
# Set this as your GitHub App's webhook secret
WEBHOOK_SECRET=

# ── Supabase ───────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001
